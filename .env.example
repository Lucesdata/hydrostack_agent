# ─────────────────────────────────────────────────────────────
# HydroStack — Environment Variables
# Copy this file to .env.local and fill in your keys.
# ─────────────────────────────────────────────────────────────

# SECOP / Socrata App Token — OPTIONAL
# Used by the SECOP tender explorer (/licitaciones). Without it, requests
# still work but are throttled to ~1k/hr per IP. Register a free app at:
# https://www.datos.gov.co/profile/edit/developer_settings
SECOP_APP_TOKEN=

# Gemini API — REQUIRED for the pliego extractor (/api/pliego/extract)
# Powers extractPliegoGemini.ts, the fallback stage of the hybrid extractor
# (rules + Gemini). Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic API key — REQUIRED for the project assistants (/asistente/*)
# Powers the AssistantChat engine (app/api/assistant/route.ts) via
# @ai-sdk/anthropic, model claude-sonnet-4-5. Get your key at:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cron secret — REQUIRED in production
# Authenticates Vercel Cron invocations of /api/cron/ingest and
# /api/cron/alertas (sent as `Authorization: Bearer <value>`). Without it,
# both endpoints respond 401 to every request (fail-closed) — set this in
# the Vercel dashboard before the crons can run. Generate one with:
# openssl rand -hex 32
CRON_SECRET=

# Postgres (Neon) — REQUIRED for the contracting data layer (fase 0.3+)
# Connection string of the Neon Postgres database that holds the raw/canonical
# tables. Provision via the Vercel Marketplace (Neon integration) and paste the
# pooled connection string here. Used by Drizzle (db:* scripts) and the ingest.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Supabase — REQUIRED for accounts (login/registro, Google OAuth)
# URL y anon key del proyecto Supabase (Project Settings → API). El anon key
# es público por diseño (se usa también en el cliente de navegador) — la
# seguridad la da RLS/las políticas de Supabase Auth, no ocultar esta key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HMAC signing secret — REQUIRED
# Firma el token de un clic del unsubscribe de alertas
# (src/lib/email/unsubscribe-token.ts). Ya no lo usa el login (eso lo
# gestiona Supabase) — se mantiene el mismo nombre para no romper tokens
# ya emitidos. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Resend API key — REQUIRED for alert emails (fase 1.3)
# Envía el digest diario de alertas (src/lib/email/send.ts). Ya no lo usa
# el login (eso lo gestiona Supabase).
# Get your key at: https://resend.com/api-keys
AUTH_RESEND_KEY=re_...

# From address for alert emails — REQUIRED for alert emails (fase 1.3)
# Must be on a domain verified in Resend (SPF/DKIM), e.g. alertas@tudominio.com
EMAIL_FROM=

# Absolute base URL of the app — REQUIRED
# Usada para construir links absolutos en correos (unsubscribe) y como
# `redirectTo` del OAuth de Google. Use your Vercel production URL in prod,
# http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
