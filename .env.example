# ─────────────────────────────────────────────────────────────
# AquaLicita — Environment Variables
# Copy this file to .env.local and fill in your keys.
# ─────────────────────────────────────────────────────────────

# SECOP / Socrata App Token — OPTIONAL
# Used by the SECOP tender explorer (/licitaciones). Without it, requests
# still work but are throttled to ~1k/hr per IP. Register a free app at:
# https://www.datos.gov.co/profile/edit/developer_settings
SECOP_APP_TOKEN=

# Gemini API — REQUIRED for the pliego extractor (/api/pliego/extract)
# Powers extractPliegoGemini.ts, the fallback stage of the hybrid extractor
# (rules + Gemini). Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic API key — REQUIRED for the project assistants (/asistente/*)
# Powers the AssistantChat engine (app/api/assistant/route.ts) via
# @ai-sdk/anthropic, model claude-sonnet-4-5. Get your key at:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cron secret — REQUIRED in production
# Authenticates Vercel Cron invocations of /api/cron/tick (el despachador que
# reemplazó a /api/cron/ingest en la Fase 5) y /api/cron/alertas, enviado como
# `Authorization: Bearer <value>`. Without it,
# both endpoints respond 401 to every request (fail-closed) — set this in
# the Vercel dashboard before the crons can run. Generate one with:
# openssl rand -hex 32
CRON_SECRET=

# Postgres — REQUIRED for the contracting data layer (fase 0.3+)
# La base VIVA es la de Supabase (aws-*.pooler.supabase.com), no Neon: la
# migración fue el 2026-08-15 y Neon quedó como residuo con la transferencia
# agotada — ver CLAUDE.md §3. Cadena de conexión pooled del mismo proyecto de
# Supabase que sirve Auth. La usan Drizzle (db:*) y la ingesta.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# DB driver override — OPTIONAL
# Set to `node` to force the `pg` (node-postgres) driver against DATABASE_URL
# instead of the default Neon serverless driver (src/lib/db/client.ts). Useful
# for local/offline Postgres that doesn't speak the Neon HTTP protocol.
DB_DRIVER=

# Supabase — REQUIRED for accounts (login/registro, Google OAuth)
# URL y anon key del proyecto Supabase (Project Settings → API). El anon key
# es público por diseño (se usa también en el cliente de navegador) — la
# seguridad la da RLS/las políticas de Supabase Auth, no ocultar esta key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HMAC signing secret — REQUIRED
# Firma el token de un clic del unsubscribe de alertas
# (src/lib/email/unsubscribe-token.ts). Ya no lo usa el login (eso lo
# gestiona Supabase) — se mantiene el mismo nombre para no romper tokens
# ya emitidos. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Resend API key — REQUIRED for alert emails (fase 1.3)
# Envía el digest diario de alertas (src/lib/email/send.ts). Ya no lo usa
# el login (eso lo gestiona Supabase).
# Get your key at: https://resend.com/api-keys
AUTH_RESEND_KEY=re_...

# From address for alert emails — REQUIRED for alert emails (fase 1.3)
# En producción debe ser un dominio verificado en Resend, con SPF, DKIM y DMARC
# publicados ANTES del primer envío masivo (SDD §7.3): p. ej.
# "AquaLicita <alertas@tudominio.com>".
# Sin dominio propio se puede usar el remitente de pruebas de Resend, que no
# exige verificación pero SOLO entrega al correo dueño de la cuenta de Resend:
#   EMAIL_FROM="AquaLicita <onboarding@resend.dev>"
# Sirve para verificar el pipeline; no sirve para usuarios reales.
EMAIL_FROM=

# Resend webhook secret — REQUIRED para la entregabilidad (fase 6)
# Firma (Svix) de los webhooks de Resend que escriben `envio_log.estado_entrega`
# y apagan la cuenta tras dos rebotes duros — app/api/webhooks/resend/route.ts.
# Sin esta variable el endpoint responde 401 fail-closed, igual que los crons:
# un webhook de entrega sin verificar es un endpoint público con el que
# cualquiera puede dar de baja las alertas de una cuenta ajena.
# Se obtiene al crear el webhook en https://resend.com/webhooks (empieza por
# `whsec_`) apuntando a https://<tu-dominio>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# Absolute base URL of the app — REQUIRED
# Usada para construir links absolutos en correos (unsubscribe) y como
# `redirectTo` del OAuth de Google. Use your Vercel production URL in prod,
# http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo concierge (2026-08-16): destino del mailto que PerfilForm ofrece
# cuando /api/perfil no puede escribir en la base (ver app/api/perfil/route.ts,
# error DB_UNAVAILABLE). Si queda vacío, el enlace igual funciona pero sin
# destinatario prellenado.
NEXT_PUBLIC_CONCIERGE_EMAIL=
